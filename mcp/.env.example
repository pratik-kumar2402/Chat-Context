# Use dev for action and success logs; use prod for warnings and errors only.
APP_ENV=dev

# Create a GitHub OAuth App with this callback URL.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_HOMEPAGE_URL=http://localhost:5173
GITHUB_CALLBACK_URL=http://localhost:5173/callback
GITHUB_OAUTH_SCOPE=read:user user:email repo

# Create a Google OAuth client and enable the Google Drive API.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5173/callback/google
MODEL_BASE_URL=http://localhost:8000
MODEL_TIMEOUT_SECONDS=180
